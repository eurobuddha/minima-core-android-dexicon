<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Relay HTTP (long-poll /dex/book and /dex/inbox, POST /dex/publish and /dex/msg) -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Android 13+ runtime notification permission for fill alerts -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Maker engine: polls the inbox and co-signs takes while the phone is in the pocket -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" android:maxSdkVersion="32" />
    <!-- Opens Android's own uninstall dialog for AtomiX / PandaPools once each has handed over (the user confirms there) -->
    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" />

    <!-- Android 11+ package visibility: the SDK discovers the Minima Core builds and pins one responder. -->
    <queries>
        <package android:name="com.eurobuddha.minimacore" />
        <package android:name="com.eurobuddha.minimablock" />
        <package android:name="com.eurobuddha.pandamonium" />
        <!-- The official Minima Core, and the legacy org.minimarex build -->
        <package android:name="org.minima.core" />
        <package android:name="org.minimarex.minimacore" />
        <!-- One trading app per phone: Dexicon contains these two and refuses to trade while either is installed -->
        <package android:name="com.eurobuddha.atomix" />
        <package android:name="com.eurobuddha.pandapools" />
    </queries>

    <!-- allowBackup=false is a FUND-SAFETY setting (family-wide scaffold defect): Auto Backup would cloud-copy and
         re-plant the my-orders table, the fill ledger and the node pairing on reinstall. A reinstall must reset. -->
    <application
        android:networkSecurityConfig="@xml/network_security_config"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Dexicon"
        tools:targetApi="31">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="keyboard|keyboardHidden|orientation|screenSize|screenLayout|smallestScreenSize|uiMode|navigation">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service android:name=".NodeTransportService" android:exported="false"
            android:process=":nodeipc" />
        <!-- One restart after the Trading Account is created: its own process, so the relaunch survives the main one. -->
        <activity
            android:name=".account.RestartActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar"
            android:process=":phoenix" />

        <service
            android:name=".maker.MakerService"
            android:exported="false"
            android:stopWithTask="false"
            android:foregroundServiceType="specialUse|dataSync">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Polls the Dexicon relay inbox, co-signs fills of the user's own resting orders and keeps the user's liquidity pools alive while the app is closed" />
        </service>

        <!-- ② Pools (vendored PandaPools). The bare host shim only forwards a stranding notification's tap to ② My pools. -->
        <activity android:name="com.eurobuddha.pandapools.MainActivity" android:exported="false" />
        <!-- The stranding notification's Re-publish action targets this; it hands the address to MakerService and stops. -->
        <service
            android:name="com.eurobuddha.pandapools.PoolKeepAliveService"
            android:exported="false"
            android:foregroundServiceType="specialUse|dataSync">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Hands a pool re-publish request from a notification to the Dexicon keep-alive service" />
        </service>
        <!-- PandaPools' statement export: only the staged accounting file (cache/export/) is ever shared. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <receiver android:name=".maker.HeartbeatReceiver" android:exported="false" />

        <receiver android:name=".maker.BootReceiver" android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
