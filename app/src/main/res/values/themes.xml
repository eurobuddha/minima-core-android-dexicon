<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Base.Theme.Dexicon" parent="Theme.Material3.DayNight.NoActionBar">
    </style>

    <style name="Theme.Dexicon" parent="Base.Theme.Dexicon" />

    <!-- Dialog chrome that follows the in-app Onyx/Daylight toggle (picked via Design.dialogTheme()). -->
    <style name="DexDialogDark" parent="android:Theme.Material.Dialog.Alert">
        <item name="android:colorBackground">#12151C</item>
        <item name="android:textColorPrimary">#EEF0F4</item>
        <item name="android:textColorSecondary">#8B909C</item>
        <item name="android:colorAccent">#F7931A</item>
        <item name="android:windowBackground">@drawable/dialog_bg_dark</item>
        <!-- Pin button text WHITE: without this, appcompat-built dialogs fall back to the Activity's
             Material3 baseline purple — unreadable on the dark background. Both attrs so the framework
             AND appcompat resolution paths land on the same style. -->
        <item name="android:buttonBarButtonStyle">@style/DexDialogBtnDark</item>
        <item name="buttonBarButtonStyle">@style/DexDialogBtnDarkCompat</item>
    </style>

    <style name="DexDialogBtnDark" parent="android:Widget.Material.Button.Borderless">
        <item name="android:textColor">#FFFFFF</item>
    </style>
    <style name="DexDialogBtnDarkCompat" parent="Widget.AppCompat.Button.Borderless">
        <item name="android:textColor">#FFFFFF</item>
    </style>

    <style name="DexDialogLight" parent="android:Theme.Material.Light.Dialog.Alert">
        <item name="android:colorBackground">#FFFFFF</item>
        <item name="android:textColorPrimary">#181B22</item>
        <item name="android:textColorSecondary">#8B909C</item>
        <item name="android:colorAccent">#F7931A</item>
        <item name="android:windowBackground">@drawable/dialog_bg_light</item>
        <item name="android:buttonBarButtonStyle">@style/DexDialogBtnLight</item>
        <item name="buttonBarButtonStyle">@style/DexDialogBtnLightCompat</item>
    </style>

    <style name="DexDialogBtnLight" parent="android:Widget.Material.Light.Button.Borderless">
        <item name="android:textColor">#181B22</item>
    </style>
    <style name="DexDialogBtnLightCompat" parent="Widget.AppCompat.Button.Borderless">
        <item name="android:textColor">#181B22</item>
    </style>
</resources>
