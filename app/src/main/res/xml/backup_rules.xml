<?xml version="1.0" encoding="utf-8"?>
<!--
   Legacy (API < 31) Auto Backup rules.

   NOTHING in this app may leave the device. allowBackup="false" already disables this, but the excludes are
   explicit so the intent survives anyone flipping that flag back. What is at stake here:
   the Dexicon identity cache, my-orders table and fill ledger — all node-specific.
         Restored onto a different node it mis-answers in both directions: starving your own rungs, or filing
         a stranger's fills as yours. Live maker slots and pending orders would be re-planted too
-->
<full-backup-content>
    <exclude domain="sharedpref" path="." />
    <exclude domain="database" path="." />
    <exclude domain="file" path="." />
    <exclude domain="external" path="." />
    <exclude domain="root" path="." />
</full-backup-content>
